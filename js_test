o localStorage:",mode);box.remove();console.log("[ModePicker] Picker UI removed")};console.log("[ModePicker] Building UI");const box=document.createElement("div");box.id=ID;box.style.cssText=%60position:fixed;z-index:2147483647;left:50%;top:24px;transform:translateX(-50%);background:#111;color:#fff;padding:10px 12px;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.35);font:13px system-ui;display:flex;gap:8px;align-items:center;pointer-events:auto;user-select:none;%60;const label=document.createElement("span");label.textContent="Pick mode:";label.style.marginRight="6px";box.appendChild(label);const lastMode=localStorage.getItem(STORAGE_KEY);console.log("[ModePicker] Last saved mode:",lastMode||"(none)");MODES.forEach(mode=>{const btn=document.createElement("button");btn.type="button";btn.textContent=mode;const isActive=mode===lastMode;btn.style.cssText=%60cursor:pointer;border:0;border-radius:10px;padding:8px 10px;background:${isActive?"#444":"#2b2b2b"};color:#fff;font:13px system-ui;pointer-events:auto;%60;btn.addEventListener('click',e=>{console.log("[ModePicker] Button click detected for mode:",mode);e.stopPropagation();e.preventDefault();insertMode(mode);},{capture:false});box.appendChild(btn)});const closeBtn=document.createElement("button");closeBtn.textContent="✕";closeBtn.style.cssText=%60cursor:pointer;border:0;margin-left:6px;border-radius:10px;padding:8px 10px;background:#2b2b2b;color:#fff;font:13px system-ui;pointer-events:auto;%60;closeBtn.addEventListener('click',e=>{console.log("[ModePicker] Close button clicked");e.stopPropagation();box.remove();},{capture:false});box.appendChild(closeBtn);const onEsc=e=>{if(e.key==="Escape"){console.log("[ModePicker] ESC pressed → closing");box.remove();document.removeEventListener("keydown",onEsc)}};document.addEventListener("keydown",onEsc);document.documentElement.appendChild(box);console.log("[ModePicker] UI appended to html root – should be visible and clickable now")})();

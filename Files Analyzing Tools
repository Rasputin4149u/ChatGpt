class SimpleHTMLIntakeParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.skip_depth = 0
        self.visible_text: list[str] = []
        self.links: list[dict[str, Any]] = []
        self.images: list[dict[str, Any]] = []
        self.scripts: list[dict[str, Any]] = []
        self.inputs: list[dict[str, Any]] = []
        self.buttons: list[dict[str, Any]] = []
        self.forms: list[dict[str, Any]] = []
        self.tags: dict[str, int] = {}

    def handle_starttag(self, tag: str, attrs: list[tuple[str, Optional[str]]]) -> None:
        tag = tag.lower()
        attr = {k.lower(): (v or "") for k, v in attrs}
        self.tags[tag] = self.tags.get(tag, 0) + 1
        if tag in {"script", "style", "noscript"}:
            self.skip_depth += 1
        if tag == "a":
            self.links.append({"href": attr.get("href", ""), "text_hint": "", "attrs": attr})
        elif tag == "img":
            self.images.append({"src": attr.get("src", ""), "alt": attr.get("alt", ""), "attrs": attr})
        elif tag == "script":
            self.scripts.append({"src": attr.get("src", ""), "type": attr.get("type", ""), "attrs": attr})
        elif tag == "input":
            self.inputs.append({"type": attr.get("type", ""), "name": attr.get("name", ""), "id": attr.get("id", ""), "attrs": attr})
        elif tag == "button":
            self.buttons.append({"id": attr.get("id", ""), "class": attr.get("class", ""), "attrs": attr})
        elif tag == "form":
            self.forms.append({"action": attr.get("action", ""), "method": attr.get("method", ""), "attrs": attr})

    def handle_endtag(self, tag: str) -> None:
        if tag.lower() in {"script", "style", "noscript"} and self.skip_depth:
            self.skip_depth -= 1

    def handle_data(self, data: str) -> None:
        if self.skip_depth:
            return
        text = " ".join(data.split())
        if text:
            self.visible_text.append(text)


def handle_html_file(ctx: IntakeContext, encoding: Optional[str] = None) -> None:
    text, enc, reason = read_text_flexible(ctx.input_path, encoding)
    parser = SimpleHTMLIntakeParser()
    parser.feed(text)
    visible = "\n".join(parser.visible_text) + "\n"

    write_text(ctx, ctx.paths.extracted_text / "html_visible_text.txt", visible)
    write_text(ctx, ctx.paths.extracted_text / "html_visible_text_numbered.txt", line_numbered_text(visible))
    write_csv_rows(ctx, ctx.paths.links / "html_links.csv", parser.links, ["href", "text_hint", "attrs"])
    write_csv_rows(ctx, ctx.paths.links / "html_images.csv", parser.images, ["src", "alt", "attrs"])
    write_json(ctx, ctx.paths.links / "html_scripts_inventory.json", parser.scripts)
    write_json(ctx, ctx.paths.links / "html_forms_inputs_buttons.json", {
        "forms": parser.forms,
        "inputs": parser.inputs,
        "buttons": parser.buttons,
    })
    summary = {
        "encoding": enc,
        "encoding_reason": reason,
        "visible_text_lines": len(visible.splitlines()),
        "links": len(parser.links),
        "images": len(parser.images),
        "scripts": len(parser.scripts),
        "forms": len(parser.forms),
        "inputs": len(parser.inputs),
        "buttons": len(parser.buttons),
        "tag_counts": parser.tags,
    }
    write_json(ctx, ctx.paths.manifests / "html_dom_summary.json", summary)
    hits = keyword_hits_rows(visible, ctx.keywords)
    write_csv_rows(ctx, ctx.paths.extracted_text / "keyword_hits.csv", hits, ["line", "keywords", "text"])
    ctx.manifest["html"] = summary
    ctx.summary.append(f"WHAT WAS EXTRACTED: visible HTML text, links, images, scripts, forms/inputs/buttons. Links={len(parser.links)}, scripts={len(parser.scripts)}.")


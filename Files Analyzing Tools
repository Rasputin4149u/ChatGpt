#!/usr/bin/env python3
# =============================================================================
# QUICK READ HEADER FOR CHATGPT / HUMAN REVIEWER
# =============================================================================
# Tool role:
#   Universal offline intake helper for uploaded files. Use it before analysis to
#   turn one uploaded file into a predictable evidence package: original copy,
#   metadata, extracted text, previews, contact sheets, timelines, manifest,
#   summary, and logs.
#
# Fast mental model:
#   INPUT FILE -> detect extension -> switch/case handler -> unified outputs.
#
# Supported families:
#   text/log/code/config: .txt .log .md .json .xml .ini .cfg .conf .ps1 .psm1
#                         .bat .cmd .js .css .py .csv .tsv .reg
#   html:                 .html .htm
#   subtitles:            .srt .vtt
#   Word:                 .docx
#   PDF:                  .pdf
#   images:               .jpg .jpeg .png .webp .bmp .gif
#   video:                .mp4 .mov .mkv .avi .webm .m4v
#
# Standard command:
#   python prepare_uploaded_file_for_analysis_AN_ADD_ON_universal_intake_LinkV2_QuickHeader.py ^
#     --input "C:\work\file.ext" ^
#     --out "C:\work\prepared_file"
#
# Useful video/debug options:
#   --video-every-seconds 1
#   --start-seconds 0
#   --end-seconds 30
#   --crop console=20,80,1500,820
#   --crop popup=350,150,750,500
#
# Most useful files for the assistant to open first:
#   analysis_summary.txt
#   manifests/manifest.json
#   logs/extraction_log.txt
#   extracted_text/*_numbered_lines.txt
#   contact_sheets/*.png
#   subtitles/srt_timeline.csv or subtitles/vtt_timeline.csv
#   video_scene_changes/timeline.csv
#
# Safety rules:
#   - Does not modify the original file.
#   - Does not use the internet.
#   - Does not run OCR by default.
#   - Optional dependencies are used only when installed; otherwise the script
#     writes warnings/errors and continues where possible.
#
# Reading/debugging convention:
#   Search for LABEL: MAIN, LABEL: ROUTER, or LABEL: HANDLE_<TYPE>. The router
#   uses Python match/case as the clean equivalent of switch/case. Error logging
#   is centralized through log_line(), record_error(), safe_call(), and
#   finalize_outputs().
# =============================================================================

r"""
prepare_uploaded_file_for_analysis_AN_ADD_ON_universal_intake_LinkV2_QuickHeader.py

Universal uploaded-file intake helper for manual/AI analysis.

Purpose
- Prepare uploaded files into a predictable analysis package.
- Preserve the original file.
- Extract available text/metadata/tables/links/images/previews.
- Render or sample visual media when optional dependencies are available.
- Write a unified manifest, summary, and log.

Supported file families
- Text/log/csv: .txt .log .csv .tsv .json .xml .ps1 .bat .cmd .js .py .htm/.html fallback
- HTML: .html .htm
- Subtitles/transcripts: .srt .vtt
- DOCX: .docx
- PDF: .pdf, with optional PyMuPDF / pypdf / PyPDF2 support
- Images: .jpg .jpeg .png .webp .bmp .gif, with optional Pillow support
- Video: .mp4 .mov .mkv .avi .webm .m4v, with optional OpenCV + Pillow support

Dependencies
- Core features use Python standard library only.
- Optional richer features:
  - Pillow for image previews/contact sheets
  - OpenCV (cv2) for video frames/scene detection
  - PyMuPDF (fitz), pypdf, or PyPDF2 for PDF extraction/rendering

Examples
python prepare_uploaded_file_for_analysis_AN_ADD_ON_universal_intake_LinkV2_QuickHeader.py ^
  --input "C:\work\evidence.pdf" ^
  --out "C:\work\prepared_evidence"

python prepare_uploaded_file_for_analysis_AN_ADD_ON_universal_intake_LinkV2_QuickHeader.py ^
  --input "C:\work\recording.mp4" ^
  --out "C:\work\prepared_recording" ^
  --video-every-seconds 1 ^
  --crop console=20,80,1500,820 ^
  --crop popup=350,150,750,500
"""


W_NS = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"
R_NS = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}"
REL_NS = "{http://schemas.openxmlformats.org/package/2006/relationships}"


def docx_text_from_element(el: ET.Element) -> str:
    parts = []
    for t in el.iter(W_NS + "t"):
        if t.text:
            parts.append(t.text)
    return "".join(parts)


def handle_docx_file(ctx: IntakeContext) -> None:
    paragraphs: list[str] = []
    tables: list[list[list[str]]] = []
    links: list[dict[str, str]] = []
    image_files: list[str] = []
    structure: dict[str, Any] = {"xml_parts": [], "media_files": []}

    with zipfile.ZipFile(ctx.input_path, "r") as z:
        names = z.namelist()
        structure["xml_parts"] = [n for n in names if n.endswith(".xml")]
        structure["media_files"] = [n for n in names if n.startswith("word/media/")]

        for media in structure["media_files"]:
            out = ctx.paths.images / "docx_embedded" / Path(media).name
            ensure_dir(out.parent)
            out.write_bytes(z.read(media))
            ctx.add_file(out)
            image_files.append(str(out))

        rel_path = "word/_rels/document.xml.rels"
        if rel_path in names:
            rel_xml = ET.fromstring(z.read(rel_path))
            for rel in rel_xml.iter(REL_NS + "Relationship"):
                if "hyperlink" in (rel.attrib.get("Type", "").lower()):
                    links.append({"id": rel.attrib.get("Id", ""), "target": rel.attrib.get("Target", ""), "type": rel.attrib.get("Type", "")})

        text_parts_by_name = []
        for part_name in ["word/document.xml"] + [n for n in names if re.match(r"word/(header|footer|comments|footnotes|endnotes)\d*\.xml$", n)]:
            if part_name not in names:
                continue
            root = ET.fromstring(z.read(part_name))
            part_paras = []
            for p in root.iter(W_NS + "p"):
                p_text = docx_text_from_element(p).strip()
                if p_text:
                    part_paras.append(p_text)
                    paragraphs.append(p_text)
            text_parts_by_name.append({"part": part_name, "paragraph_count": len(part_paras)})

            for tbl in root.iter(W_NS + "tbl"):
                table_rows = []
                for tr in tbl.iter(W_NS + "tr"):
                    row = []
                    for tc in tr.iter(W_NS + "tc"):
                        row.append(docx_text_from_element(tc).strip())
                    if row:
                        table_rows.append(row)
                if table_rows:
                    tables.append(table_rows)

    body_text = "\n".join(paragraphs) + "\n"
    write_text(ctx, ctx.paths.extracted_text / "docx_text.txt", body_text)
    write_text(ctx, ctx.paths.extracted_text / "docx_text_numbered_lines.txt", line_numbered_text(body_text))
    write_csv_rows(ctx, ctx.paths.links / "docx_links.csv", links, ["id", "target", "type"])
    write_json(ctx, ctx.paths.manifests / "docx_structure.json", {
        **structure,
        "text_parts": text_parts_by_name,
        "paragraph_count": len(paragraphs),
        "table_count": len(tables),
        "link_count": len(links),
    })

    for idx, table in enumerate(tables, 1):
        max_cols = max((len(r) for r in table), default=0)
        out = ctx.paths.tables / f"docx_table_{idx:03d}.csv"
        ensure_dir(out.parent)
        with out.open("w", encoding="utf-8-sig", newline="") as f:
            writer = csv.writer(f)
            for row in table:
                writer.writerow(row + [""] * (max_cols - len(row)))
        ctx.add_file(out)

    hits = keyword_hits_rows(body_text, ctx.keywords)
    write_csv_rows(ctx, ctx.paths.extracted_text / "keyword_hits.csv", hits, ["line", "keywords", "text"])
    ctx.manifest["docx"] = {"paragraphs": len(paragraphs), "tables": len(tables), "links": len(links), "embedded_images": len(image_files)}
    ctx.summary.append(f"WHAT WAS EXTRACTED: DOCX paragraphs, numbered text, tables, links, embedded images. Paragraphs={len(paragraphs)}, tables={len(tables)}.")


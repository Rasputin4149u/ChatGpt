# LABEL: SRT / VTT HANDLER
# =============================================================================

def timestamp_to_seconds(value: str) -> float:
    value = value.strip().replace(",", ".")
    parts = value.split(":")
    if len(parts) == 3:
        h, m, s = parts
        return int(h) * 3600 + int(m) * 60 + float(s)
    if len(parts) == 2:
        m, s = parts
        return int(m) * 60 + float(s)
    return float(parts[0])


def parse_srt_or_vtt(text: str, is_vtt: bool = False) -> list[dict[str, Any]]:
    text = normalize_newlines(text).strip("\ufeff\n ")
    if is_vtt:
        text = re.sub(r"^WEBVTT.*?(?:\n\n|$)", "", text, flags=re.IGNORECASE | re.DOTALL)
    blocks = re.split(r"\n\s*\n", text)
    segments = []
    idx_auto = 1
    time_re = re.compile(r"(?P<start>\d{1,2}:\d{2}:\d{2}[,.]\d{3}|\d{2}:\d{2}[,.]\d{3})\s*-->\s*(?P<end>\d{1,2}:\d{2}:\d{2}[,.]\d{3}|\d{2}:\d{2}[,.]\d{3})")
    for raw in blocks:
        lines = [line.strip("\ufeff") for line in raw.splitlines() if line.strip()]
        if not lines:
            continue
        time_line_index = None
        m = None
        for i, line in enumerate(lines[:3]):
            m = time_re.search(line)
            if m:
                time_line_index = i
                break
        if not m or time_line_index is None:
            continue
        index_text = lines[0] if time_line_index > 0 else str(idx_auto)
        try:
            index = int(index_text)
        except Exception:
            index = idx_auto
        text_lines = lines[time_line_index + 1:]
        seg_text = " ".join(text_lines).strip()
        start = m.group("start")
        end = m.group("end")
        start_sec = timestamp_to_seconds(start)
        end_sec = timestamp_to_seconds(end)
        segments.append({
            "index": index,
            "start": start,
            "end": end,
            "start_seconds": round(start_sec, 3),
            "end_seconds": round(end_sec, 3),
            "duration_seconds": round(max(0.0, end_sec - start_sec), 3),
            "text": seg_text,
        })
        idx_auto += 1
    return segments


def handle_subtitle_file(ctx: IntakeContext, encoding: Optional[str] = None) -> None:
    raw_text, enc, reason = read_text_flexible(ctx.input_path, encoding)
    raw_text = normalize_newlines(raw_text)
    is_vtt = ctx.input_path.suffix.lower() == ".vtt"
    segments = parse_srt_or_vtt(raw_text, is_vtt=is_vtt)

    write_text(ctx, ctx.paths.subtitles / f"subtitle_raw_copy{ctx.input_path.suffix.lower()}", raw_text)
    write_json(ctx, ctx.paths.subtitles / "srt_vtt_segments.json", segments)
    write_text(ctx, ctx.paths.subtitles / "srt_vtt_text_only.txt", "\n".join(s["text"] for s in segments) + "\n")
    write_text(ctx, ctx.paths.subtitles / "srt_vtt_numbered_blocks.txt", "\n\n".join(
        f"BLOCK {s['index']}\n{s['start']} --> {s['end']}\n{s['text']}" for s in segments
    ) + "\n")
    write_text(ctx, ctx.paths.subtitles / "srt_vtt_clean_transcript_with_timecodes.txt", "\n".join(
        f"[{s['start']} - {s['end']}] {s['text']}" for s in segments
    ) + "\n")

    rows = []
    for s in segments:
        low = s["text"].lower()
        keys = [k for k in ctx.keywords if k in low]
        row = dict(s)
        row["has_keyword"] = bool(keys)
        row["keywords"] = ";".join(keys)
        rows.append(row)
    write_csv_rows(ctx, ctx.paths.subtitles / "srt_vtt_timeline.csv", rows, [
        "index", "start", "end", "start_seconds", "end_seconds", "duration_seconds", "text", "has_keyword", "keywords",
    ])

    warnings = []
    long_gaps = []
    overlaps = []
    for prev, cur in zip(segments, segments[1:]):
        gap = cur["start_seconds"] - prev["end_seconds"]
        if gap > 10:
            long_gaps.append({"after_index": prev["index"], "before_index": cur["index"], "gap_seconds": round(gap, 3)})
        if gap < -0.1:
            overlaps.append({"first_index": prev["index"], "second_index": cur["index"], "overlap_seconds": round(abs(gap), 3)})
    stats = {
        "encoding": enc,
        "encoding_reason": reason,
        "segment_count": len(segments),
        "total_transcript_seconds": segments[-1]["end_seconds"] if segments else 0,
        "long_gap_count_gt_10s": len(long_gaps),
        "overlap_count": len(overlaps),
        "long_gaps": long_gaps[:100],
        "overlaps": overlaps[:100],
    }
    write_json(ctx, ctx.paths.subtitles / "srt_vtt_stats.json", stats)
    ctx.manifest["subtitles"] = stats
    ctx.summary.append(f"WHAT WAS EXTRACTED: subtitle timeline CSV, clean transcript, segments JSON, stats. Segments={len(segments)}.")


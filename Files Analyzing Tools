def try_import_fitz():
    try:
        import fitz  # type: ignore
        return fitz
    except Exception:
        return None


def try_import_pypdf():
    try:
        import pypdf  # type: ignore
        return pypdf
    except Exception:
        try:
            import PyPDF2 as pypdf  # type: ignore
            return pypdf
        except Exception:
            return None


def handle_pdf_file(ctx: IntakeContext, max_render_pages: int = 50) -> None:
    fitz = try_import_fitz()
    pypdf = None if fitz else try_import_pypdf()
    page_texts: list[str] = []
    rendered_pages: list[str] = []
    page_count: Optional[int] = None

    if fitz:
        doc = fitz.open(str(ctx.input_path))
        page_count = doc.page_count
        for i, page in enumerate(doc):
            text = page.get_text("text") or ""
            page_texts.append(text)
            out_text = ctx.paths.extracted_text / "pdf_text_by_page" / f"page_{i+1:03d}.txt"
            write_text(ctx, out_text, text)
            if i < max_render_pages:
                pix = page.get_pixmap(matrix=fitz.Matrix(1.5, 1.5), alpha=False)
                out_png = ctx.paths.previews / "pdf_rendered_pages" / f"page_{i+1:03d}.png"
                ensure_dir(out_png.parent)
                pix.save(str(out_png))
                ctx.add_file(out_png)
                rendered_pages.append(str(out_png))
        doc.close()
    elif pypdf:
        reader = pypdf.PdfReader(str(ctx.input_path))
        page_count = len(reader.pages)
        for i, page in enumerate(reader.pages):
            text = page.extract_text() or ""
            page_texts.append(text)
            write_text(ctx, ctx.paths.extracted_text / "pdf_text_by_page" / f"page_{i+1:03d}.txt", text)
    else:
        ctx.summary.append("WHAT FAILED: PDF extraction needs optional PyMuPDF, pypdf, or PyPDF2. No PDF text/render extraction was available.")
        ctx.manifest["pdf"] = {"status": "no_pdf_library_available"}
        return

    all_text = "\n\n".join(f"--- PAGE {i+1} ---\n{text}" for i, text in enumerate(page_texts))
    write_text(ctx, ctx.paths.extracted_text / "pdf_all_text.txt", all_text)
    write_text(ctx, ctx.paths.extracted_text / "pdf_all_text_numbered_lines.txt", line_numbered_text(all_text))

    text_lengths = [len(t.strip()) for t in page_texts]
    likely_scanned_pages = [i + 1 for i, length in enumerate(text_lengths) if length < 20]
    pdf_type = "text_pdf"
    if page_count and len(likely_scanned_pages) == page_count:
        pdf_type = "scanned_or_image_pdf"
    elif likely_scanned_pages:
        pdf_type = "mixed_pdf"

    if rendered_pages:
        safe_call(ctx, "PDF_CONTACT_SHEET", create_contact_sheet_from_paths, ctx, [Path(p) for p in rendered_pages], ctx.paths.contact_sheets / "pdf_contact_sheet_pages.png", 4, 300)

    hits = keyword_hits_rows(all_text, ctx.keywords)
    write_csv_rows(ctx, ctx.paths.extracted_text / "keyword_hits.csv", hits, ["line", "keywords", "text"])
    pdf_meta = {
        "page_count": page_count,
        "pdf_type_estimate": pdf_type,
        "rendered_page_count": len(rendered_pages),
        "likely_scanned_or_no_text_pages": likely_scanned_pages[:200],
        "total_text_chars": len(all_text),
    }
    write_json(ctx, ctx.paths.manifests / "pdf_manifest.json", pdf_meta)
    ctx.manifest["pdf"] = pdf_meta
    ctx.summary.append(f"WHAT WAS EXTRACTED: PDF text by page, combined text, keyword hits; rendered pages if PyMuPDF available. Type estimate={pdf_type}.")


def try_import_cv2():
    try:
        import cv2  # type: ignore
        return cv2
    except Exception:
        return None


def bgr_to_pil_image(frame_bgr):
    cv2 = try_import_cv2()
    Image, _, _ = try_import_pillow()
    if cv2 is None or Image is None:
        raise RuntimeError("cv2/Pillow missing")
    rgb = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB)
    return Image.fromarray(rgb)


def save_bgr_frame(ctx: IntakeContext, frame_bgr, out_path: Path) -> None:
    img = bgr_to_pil_image(frame_bgr)
    ensure_dir(out_path.parent)
    img.save(out_path)
    ctx.add_file(out_path)


def safe_crop_bgr(frame_bgr, rect: tuple[int, int, int, int]):
    x, y, w, h = rect
    h_img, w_img = frame_bgr.shape[:2]
    x1, y1 = max(0, x), max(0, y)
    x2, y2 = min(w_img, x + w), min(h_img, y + h)
    if x1 >= x2 or y1 >= y2:
        return None
    return frame_bgr[y1:y2, x1:x2]


def frame_diff_score(cv2, prev_bgr, cur_bgr) -> float:
    prev = cv2.resize(cv2.cvtColor(prev_bgr, cv2.COLOR_BGR2GRAY), (320, 180))
    cur = cv2.resize(cv2.cvtColor(cur_bgr, cv2.COLOR_BGR2GRAY), (320, 180))
    diff = cv2.absdiff(prev, cur)
    return float(diff.mean())


def handle_video_file(ctx: IntakeContext, args: argparse.Namespace) -> None:
    cv2 = try_import_cv2()
    Image, _, _ = try_import_pillow()
    if cv2 is None or Image is None:
        ctx.summary.append("WHAT FAILED: video handling requires optional OpenCV (cv2) and Pillow.")
        ctx.manifest["video"] = {"status": "cv2_or_pillow_not_available"}
        return

    cap = cv2.VideoCapture(str(ctx.input_path))
    if not cap.isOpened():
        ctx.summary.append("WHAT FAILED: OpenCV could not open the video file.")
        ctx.manifest["video"] = {"status": "cannot_open_video"}
        return

    fps = float(cap.get(cv2.CAP_PROP_FPS) or 0)
    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
    duration = (total_frames / fps) if fps else None
    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH) or 0)
    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT) or 0)

    start_ms = int(max(0.0, args.video_start_seconds) * 1000)
    step_ms = max(1, int(max(0.05, args.video_every_seconds) * 1000))
    end_ms = int(args.video_end_seconds * 1000) if args.video_end_seconds is not None else (int(duration * 1000) if duration else None)

    sampled_paths: list[Path] = []
    scene_paths: list[Path] = []
    popup_paths: list[Path] = []
    console_paths: list[Path] = []
    timeline_rows: list[dict[str, Any]] = []
    dense_source_seconds: list[float] = []

    prev_frame = None
    prev_console = None
    idx = 0
    current_ms = start_ms

    while True:
        if end_ms is not None and current_ms > end_ms:
            break
        cap.set(cv2.CAP_PROP_POS_MSEC, current_ms)
        ok, frame = cap.read()
        if not ok or frame is None:
            break

        label = f"{idx:04d}_{current_ms:08d}ms"
        frame_path = ctx.paths.video_frames / f"{label}.png"
        save_bgr_frame(ctx, frame, frame_path)
        sampled_paths.append(frame_path)

        crop_files = {}
        for name, rect in ctx.crop_rects.items():
            crop = safe_crop_bgr(frame, rect)
            if crop is not None:
                crop_out = ctx.paths.crops / name / f"{label}_{name}.png"
                save_bgr_frame(ctx, crop, crop_out)
                crop_files[name] = str(crop_out)

        score = 0.0
        is_scene_change = False
        is_popup_candidate = False
        is_console_change = False
        console_score = 0.0

        if prev_frame is not None:
            score = frame_diff_score(cv2, prev_frame, frame)
            is_scene_change = score >= args.video_change_threshold
            if is_scene_change:
                out = ctx.paths.video_scene_changes / f"{label}_change_{score:.2f}.png"
                save_bgr_frame(ctx, frame, out)
                scene_paths.append(out)
                dense_source_seconds.append(current_ms / 1000.0)

            # Popup heuristic: scene change plus noticeable center-region change.
            h, w = frame.shape[:2]
            center_rect = (int(w * 0.20), int(h * 0.15), int(w * 0.60), int(h * 0.70))
            prev_center = safe_crop_bgr(prev_frame, center_rect)
            cur_center = safe_crop_bgr(frame, center_rect)
            center_score = frame_diff_score(cv2, prev_center, cur_center) if prev_center is not None and cur_center is not None else 0.0
            is_popup_candidate = is_scene_change and center_score >= args.video_change_threshold
            if is_popup_candidate:
                out = ctx.paths.video_popup_candidates / f"{label}_popup_{center_score:.2f}.png"
                save_bgr_frame(ctx, frame, out)
                popup_paths.append(out)

            # Console-change heuristic: named console crop if supplied, otherwise full frame.
            console_rect = ctx.crop_rects.get("console")
            cur_console = safe_crop_bgr(frame, console_rect) if console_rect else frame
            if prev_console is not None and cur_console is not None:
                console_score = frame_diff_score(cv2, prev_console, cur_console)
                is_console_change = console_score >= args.video_console_change_threshold
                if is_console_change:
                    out = ctx.paths.video_console_changes / f"{label}_console_{console_score:.2f}.png"
                    save_bgr_frame(ctx, frame, out)
                    console_paths.append(out)
            prev_console = cur_console.copy() if cur_console is not None else None
        else:
            console_rect = ctx.crop_rects.get("console")
            first_console = safe_crop_bgr(frame, console_rect) if console_rect else frame
            prev_console = first_console.copy() if first_console is not None else None

        timeline_rows.append({
            "index": idx,
            "ms": current_ms,
            "seconds": round(current_ms / 1000.0, 3),
            "frame_path": str(frame_path),
            "change_score": round(score, 3),
            "scene_change": is_scene_change,
            "popup_candidate": is_popup_candidate,
            "console_change": is_console_change,
            "console_score": round(console_score, 3),
            "crops": json.dumps(crop_files, ensure_ascii=False),
        })

        prev_frame = frame.copy()
        idx += 1
        current_ms += step_ms
        if duration and current_ms > int(duration * 1000):
            break

    # Dense extraction around detected scene changes.
    dense_paths: list[Path] = []
    if not args.no_video_dense and dense_source_seconds:
        for change_idx, sec in enumerate(dense_source_seconds[:args.max_dense_events], 1):
            start = max(0.0, sec - args.video_dense_window_seconds)
            end = sec + args.video_dense_window_seconds
            t = start
            dense_i = 0
            while t <= end:
                cap.set(cv2.CAP_PROP_POS_MSEC, int(t * 1000))
                ok, frame = cap.read()
                if not ok or frame is None:
                    break
                out = ctx.paths.video_dense_around_changes / f"change_{change_idx:03d}" / f"{dense_i:04d}_{int(t*1000):08d}ms.png"
                save_bgr_frame(ctx, frame, out)
                dense_paths.append(out)
                dense_i += 1
                t += args.video_dense_every_seconds

    cap.release()

    write_csv_rows(ctx, ctx.paths.manifests / "video_timeline.csv", timeline_rows, [
        "index", "ms", "seconds", "frame_path", "change_score", "scene_change", "popup_candidate", "console_change", "console_score", "crops",
    ])
    timeline_txt = "\n".join(
        f"{row['seconds']:08.3f}s | change={row['change_score']} | scene={row['scene_change']} | popup={row['popup_candidate']} | console={row['console_change']} | {row['frame_path']}"
        for row in timeline_rows
    ) + "\n"
    write_text(ctx, ctx.paths.manifests / "video_timeline.txt", timeline_txt)

    if sampled_paths:
        safe_call(ctx, "VIDEO_CONTACT_SHEET_ALL", create_contact_sheet_from_paths, ctx, sampled_paths, ctx.paths.contact_sheets / "video_contact_sheet_all.png", args.video_contact_cols, args.video_thumb_width)
    if scene_paths:
        safe_call(ctx, "VIDEO_CONTACT_SHEET_SCENE_CHANGES", create_contact_sheet_from_paths, ctx, scene_paths, ctx.paths.contact_sheets / "video_contact_sheet_scene_changes.png", args.video_contact_cols, args.video_thumb_width)
    if popup_paths:
        safe_call(ctx, "VIDEO_CONTACT_SHEET_POPUPS", create_contact_sheet_from_paths, ctx, popup_paths, ctx.paths.contact_sheets / "video_contact_sheet_popup_candidates.png", args.video_contact_cols, args.video_thumb_width)
    if console_paths:
        safe_call(ctx, "VIDEO_CONTACT_SHEET_CONSOLE", create_contact_sheet_from_paths, ctx, console_paths, ctx.paths.contact_sheets / "video_contact_sheet_console_changes.png", args.video_contact_cols, args.video_thumb_width)

    video_meta = {
        "fps": fps,
        "total_frames": total_frames,
        "duration_seconds": duration,
        "width": width,
        "height": height,
        "sampled_frame_count": len(sampled_paths),
        "scene_change_count": len(scene_paths),
        "popup_candidate_count": len(popup_paths),
        "console_change_count": len(console_paths),
        "dense_frame_count": len(dense_paths),
        "every_seconds": args.video_every_seconds,
        "start_seconds": args.video_start_seconds,
        "end_seconds": args.video_end_seconds,
        "crop_names": sorted(ctx.crop_rects.keys()),
    }
    write_json(ctx, ctx.paths.manifests / "video_manifest.json", video_meta)
    ctx.manifest["video"] = video_meta
    ctx.summary.append(f"WHAT WAS EXTRACTED: video sampled frames, timeline CSV/TXT, contact sheets, scene changes, popup candidates, console changes, dense frames. Sampled={len(sampled_paths)}.")

# =============================================================================
# LABEL: UNKNOWN HANDLER
# =============================================================================

def handle_unknown_file(ctx: IntakeContext) -> None:
    ctx.summary.append("WHAT WAS EXTRACTED: common metadata and SHA256 only. File type is not supported by a specific handler.")
    ctx.manifest["unknown"] = {"extension": ctx.input_path.suffix.lower(), "status": "metadata_only"}

# =============================================================================
# LABEL: ROUTER / MAIN
# =============================================================================

def route_by_file_type(ctx: IntakeContext, args: argparse.Namespace) -> None:
    ext = ctx.input_path.suffix.lower()
    log_line(ctx, "INFO", "ROUTE BY FILE TYPE", {"extension": ext})

    # Python 3.10+ match/case router. This intentionally resembles switch/case.
    match ext:
        case e if e in HTML_EXTENSIONS:
            handle_html_file(ctx, args.encoding)
        case e if e in SUBTITLE_EXTENSIONS:
            handle_subtitle_file(ctx, args.encoding)
        case e if e in DOCX_EXTENSIONS:
            handle_docx_file(ctx)
        case e if e in PDF_EXTENSIONS:
            handle_pdf_file(ctx, args.max_pdf_pages_render)
        case e if e in IMAGE_EXTENSIONS:
            handle_image_file(ctx)
        case e if e in VIDEO_EXTENSIONS:
            handle_video_file(ctx, args)
        case e if e in TEXT_EXTENSIONS:
            handle_text_like_file(ctx, args.encoding)
        case _:
            # Last-chance text attempt for small unknown files.
            try:
                if ctx.input_path.stat().st_size <= args.unknown_text_probe_max_bytes:
                    handle_text_like_file(ctx, args.encoding)
                    ctx.manifest["unknown_probe"] = {"status": "read_as_text"}
                else:
                    handle_unknown_file(ctx)
            except Exception:
                handle_unknown_file(ctx)


def parse_args(argv: Optional[list[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Prepare uploaded files for analysis into a unified output package.")
    parser.add_argument("--input", required=True, help="Input file path")
    parser.add_argument("--out", required=True, help="Output folder")
    parser.add_argument("--encoding", default=None, help="Force text encoding, otherwise auto-try common encodings")
    parser.add_argument("--keyword", action="append", default=[], help="Extra keyword to search for. Can be repeated.")
    parser.add_argument("--keywords-file", default=None, help="Optional text file with one keyword per line")
    parser.add_argument("--crop", action="append", default=[], help="Named crop, format name=x,y,w,h. Can be repeated.")
    parser.add_argument("--no-copy-original", action="store_true", help="Do not copy original file into output/original")
    parser.add_argument("--unknown-text-probe-max-bytes", type=int, default=2_000_000, help="Try reading unknown files as text when <= this size")

    # PDF options
    parser.add_argument("--max-pdf-pages-render", type=int, default=50, help="Max PDF pages to render when PyMuPDF is available")

    # Video options
    parser.add_argument("--video-every-seconds", type=float, default=1.0, help="Sample video every N seconds")
    parser.add_argument("--video-start-seconds", type=float, default=0.0, help="Video start second")
    parser.add_argument("--video-end-seconds", type=float, default=None, help="Optional video end second")
    parser.add_argument("--video-contact-cols", type=int, default=4, help="Video contact sheet columns")
    parser.add_argument("--video-thumb-width", type=int, default=360, help="Video contact sheet thumb width")
    parser.add_argument("--video-change-threshold", type=float, default=12.0, help="Scene/popup change threshold")
    parser.add_argument("--video-console-change-threshold", type=float, default=6.0, help="Console crop change threshold")
    parser.add_argument("--no-video-dense", action="store_true", help="Disable dense extraction around scene changes")
    parser.add_argument("--video-dense-window-seconds", type=float, default=2.0, help="Dense extraction window before/after scene changes")
    parser.add_argument("--video-dense-every-seconds", type=float, default=0.2, help="Dense extraction interval")
    parser.add_argument("--max-dense-events", type=int, default=20, help="Max scene-change events for dense extraction")
    return parser.parse_args(argv)


def main(argv: Optional[list[str]] = None) -> int:
    args = parse_args(argv)
    ctx = init_context(args)
    try:
        if not ctx.input_path.exists():
            raise FileNotFoundError(f"Input file does not exist: {ctx.input_path}")
        metadata = collect_file_metadata(ctx)
        if not args.no_copy_original:
            copy_file(ctx, ctx.input_path, ctx.paths.original / ctx.input_path.name)
        ctx.manifest["options"] = vars(args)
        route_by_file_type(ctx, args)
        return_code = 0 if not ctx.errors else 2
    except Exception as exc:
        record_error(ctx, "MAIN", exc)
        return_code = 1
    finally:
        try:
            finalize_outputs(ctx)
        except Exception as exc:
            # Last-resort stderr to avoid silent failure.
            print(f"FINALIZE ERROR: {type(exc).__name__}: {exc}", file=sys.stderr)
            traceback.print_exc()
            return_code = 1
    return return_code


if __name__ == "__main__":
    raise SystemExit(main())

def try_import_pillow():
    try:
        from PIL import Image, ImageOps, ImageEnhance  # type: ignore
        return Image, ImageOps, ImageEnhance
    except Exception:
        return None, None, None


def create_contact_sheet_from_paths(ctx: IntakeContext, image_paths: list[Path], out_path: Path, cols: int = 4, thumb_width: int = 360) -> None:
    Image, ImageOps, _ = try_import_pillow()
    if Image is None:
        raise RuntimeError("Pillow is not available")
    if not image_paths:
        raise ValueError("No images supplied for contact sheet")
    thumbs = []
    max_h = 0
    for path in image_paths:
        img = Image.open(path).convert("RGB")
        ratio = thumb_width / max(1, img.width)
        thumb = img.resize((thumb_width, max(1, int(img.height * ratio))))
        label_h = 24
        labeled = ImageOps.expand(thumb, border=(0, 0, 0, label_h), fill="white")
        try:
            from PIL import ImageDraw  # type: ignore
            draw = ImageDraw.Draw(labeled)
            draw.text((6, thumb.height + 4), path.stem[:50], fill="black")
        except Exception:
            pass
        thumbs.append(labeled)
        max_h = max(max_h, labeled.height)
    import math
    rows = math.ceil(len(thumbs) / cols)
    sheet = Image.new("RGB", (cols * thumb_width, rows * max_h), "white")
    for idx, thumb in enumerate(thumbs):
        row, col = divmod(idx, cols)
        sheet.paste(thumb, (col * thumb_width, row * max_h))
    ensure_dir(out_path.parent)
    sheet.save(out_path)
    ctx.add_file(out_path)


def handle_image_file(ctx: IntakeContext) -> None:
    Image, ImageOps, ImageEnhance = try_import_pillow()
    if Image is None:
        ctx.summary.append("WHAT FAILED: Pillow is not available, so only common file metadata was extracted for this image.")
        ctx.manifest["image"] = {"status": "pillow_not_available"}
        return

    img = Image.open(ctx.input_path)
    try:
        img = ImageOps.exif_transpose(img)
    except Exception:
        pass
    image_meta = {
        "format": img.format,
        "mode": img.mode,
        "width": img.width,
        "height": img.height,
        "has_exif": bool(getattr(img, "getexif", lambda: {})()),
    }
    write_json(ctx, ctx.paths.metadata / "image_metadata.json", image_meta)

    rgb = img.convert("RGB")
    preview = rgb.copy()
    preview.thumbnail((1600, 1600))
    preview_path = ctx.paths.previews / "image_preview_scaled.png"
    preview.save(preview_path)
    ctx.add_file(preview_path)

    high = ImageOps.autocontrast(rgb.convert("L")).convert("RGB")
    high.thumbnail((1600, 1600))
    high_path = ctx.paths.previews / "image_preview_high_contrast.png"
    high.save(high_path)
    ctx.add_file(high_path)

    crop_outputs = []
    for name, (x, y, w, h) in ctx.crop_rects.items():
        crop = rgb.crop((max(0, x), max(0, y), min(rgb.width, x + w), min(rgb.height, y + h)))
        if crop.width > 0 and crop.height > 0:
            out = ctx.paths.crops / f"image_crop_{name}.png"
            crop.save(out)
            ctx.add_file(out)
            crop_outputs.append(str(out))

    safe_call(ctx, "IMAGE_CONTACT_SHEET", create_contact_sheet_from_paths, ctx, [preview_path, high_path], ctx.paths.contact_sheets / "image_contact_sheet.png", 2, 500)
    ctx.manifest["image"] = {**image_meta, "crop_count": len(crop_outputs)}
    ctx.summary.append(f"WHAT WAS EXTRACTED: image metadata, scaled preview, high-contrast preview, optional crops. Size={img.width}x{img.height}.")


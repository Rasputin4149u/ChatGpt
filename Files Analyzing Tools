# LABEL: LOGGING / ERROR HANDLING
# =============================================================================

def utc_now_iso() -> str:
    return _dt.datetime.now(_dt.timezone.utc).isoformat(timespec="seconds")


def local_stamp() -> str:
    return _dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]


def log_line(ctx: IntakeContext, level: str, message: str, data: Optional[dict[str, Any]] = None) -> None:
    payload = f"[{local_stamp()}] [{level.upper()}] {message}"
    if data:
        payload += " | " + json.dumps(data, ensure_ascii=False, default=str)
    print(payload)
    if ctx.log_path:
        try:
            with ctx.log_path.open("a", encoding="utf-8") as f:
                f.write(payload + "\n")
        except Exception:
            pass
    ctx.manifest.setdefault("log_events", []).append({
        "time": local_stamp(),
        "level": level.upper(),
        "message": message,
        "data": data or {},
    })


def record_error(ctx: IntakeContext, where: str, exc: BaseException) -> None:
    text = f"{where}: {type(exc).__name__}: {exc}"
    ctx.errors.append(text)
    log_line(ctx, "ERROR", text, {"traceback": traceback.format_exc()})


def safe_call(ctx: IntakeContext, label: str, func, *args, **kwargs):
    try:
        log_line(ctx, "INFO", f"ENTER {label}")
        result = func(*args, **kwargs)
        log_line(ctx, "INFO", f"EXIT {label}")
        return result
    except Exception as exc:
        record_error(ctx, label, exc)
        return None

# =============================================================================
# LABEL: FILESYSTEM HELPERS
# =============================================================================

def ensure_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def write_text(ctx: IntakeContext, path: Path, text: str) -> None:
    ensure_dir(path.parent)
    path.write_text(text, encoding="utf-8", errors="replace")
    ctx.add_file(path)


def write_json(ctx: IntakeContext, path: Path, data: Any) -> None:
    ensure_dir(path.parent)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2, default=str), encoding="utf-8")
    ctx.add_file(path)


def copy_file(ctx: IntakeContext, src: Path, dst: Path) -> None:
    ensure_dir(dst.parent)
    shutil.copy2(src, dst)
    ctx.add_file(dst)


def safe_filename(value: str, max_len: int = 120) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "_", value.strip())
    cleaned = cleaned.strip("._") or "file"
    return cleaned[:max_len]


def sha256_file(path: Path, block_size: int = 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(block_size), b""):
            h.update(block)
    return h.hexdigest()


def parse_crop(value: str) -> tuple[str, tuple[int, int, int, int]]:
    if "=" not in value:
        raise argparse.ArgumentTypeError("crop must be name=x,y,w,h")
    name, rect_text = value.split("=", 1)
    name = safe_filename(name)
    parts = [p.strip() for p in rect_text.split(",")]
    if len(parts) != 4:
        raise argparse.ArgumentTypeError("crop rect must be x,y,w,h")
    try:
        x, y, w, h = map(int, parts)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("crop values must be integers") from exc
    if w <= 0 or h <= 0:
        raise argparse.ArgumentTypeError("crop width/height must be > 0")
    return name, (x, y, w, h)


def build_output_paths(out_dir: Path) -> OutputPaths:
    return OutputPaths(
        root=out_dir,
        original=out_dir / "original",
        metadata=out_dir / "metadata",
        extracted_text=out_dir / "extracted_text",
        previews=out_dir / "previews",
        images=out_dir / "images",
        video_frames=out_dir / "video_frames",
        video_scene_changes=out_dir / "video_scene_changes",
        video_console_changes=out_dir / "video_console_changes",
        video_popup_candidates=out_dir / "video_popup_candidates",
        video_dense_around_changes=out_dir / "video_dense_around_changes",
        tables=out_dir / "tables",
        links=out_dir / "links",
        subtitles=out_dir / "subtitles",
        manifests=out_dir / "manifests",
        logs=out_dir / "logs",
        contact_sheets=out_dir / "contact_sheets",
        errors=out_dir / "errors",
        crops=out_dir / "crops",
    )


def init_context(args: argparse.Namespace) -> IntakeContext:
    input_path = Path(args.input).expanduser().resolve()
    out_dir = Path(args.out).expanduser().resolve()
    paths = build_output_paths(out_dir)
    for p in asdict(paths).values():
        ensure_dir(Path(p))

    keywords = list(DEFAULT_KEYWORDS)
    if args.keyword:
        keywords.extend(args.keyword)
    if args.keywords_file:
        kpath = Path(args.keywords_file).expanduser()
        if kpath.exists():
            text = kpath.read_text(encoding="utf-8", errors="replace")
            keywords.extend([line.strip() for line in text.splitlines() if line.strip()])

    crops = {}
    for crop_item in args.crop or []:
        name, rect = parse_crop(crop_item)
        crops[name] = rect

    ctx = IntakeContext(
        input_path=input_path,
        out_dir=out_dir,
        paths=paths,
        started_at=utc_now_iso(),
        keywords=sorted(set(k.lower() for k in keywords if k.strip())),
        crop_rects=crops,
    )
    ctx.log_path = paths.logs / "extraction_log.txt"
    log_line(ctx, "INFO", "UNIVERSAL INTAKE START", {"script": SCRIPT_NAME, "version": SCRIPT_VERSION})
    return ctx

# =============================================================================
# LABEL: METADATA / MANIFEST
# =============================================================================

def collect_file_metadata(ctx: IntakeContext) -> dict[str, Any]:
    path = ctx.input_path
    stat = path.stat()
    mime, encoding = mimetypes.guess_type(str(path))
    metadata = {
        "script_name": SCRIPT_NAME,
        "script_version": SCRIPT_VERSION,
        "started_at_utc": ctx.started_at,
        "input_path": str(path),
        "file_name": path.name,
        "extension": path.suffix.lower(),
        "size_bytes": stat.st_size,
        "modified_time": _dt.datetime.fromtimestamp(stat.st_mtime).isoformat(timespec="seconds"),
        "created_time": _dt.datetime.fromtimestamp(stat.st_ctime).isoformat(timespec="seconds"),
        "mime_guess": mime,
        "encoding_guess": encoding,
        "sha256": sha256_file(path),
    }
    write_json(ctx, ctx.paths.metadata / "metadata.json", metadata)
    write_text(ctx, ctx.paths.metadata / "file_hashes.txt", f"SHA256  {metadata['sha256']}  {path.name}\n")
    ctx.manifest["metadata"] = metadata
    ctx.summary.append(f"FILE TYPE: {metadata['extension'] or 'unknown'} / {metadata['mime_guess'] or 'unknown MIME'}")
    ctx.summary.append(f"INPUT FILE: {path}")
    ctx.summary.append(f"SHA256: {metadata['sha256']}")
    return metadata


def finalize_outputs(ctx: IntakeContext) -> None:
    ctx.manifest["finished_at_utc"] = utc_now_iso()
    ctx.manifest["created_files"] = ctx.created_files
    ctx.manifest["errors"] = ctx.errors
    ctx.manifest["summary"] = ctx.summary
    write_json(ctx, ctx.paths.manifests / "manifest.json", ctx.manifest)

    if ctx.errors:
        write_text(ctx, ctx.paths.errors / "errors.txt", "\n".join(ctx.errors) + "\n")
        ctx.summary.append(f"WARNINGS: {len(ctx.errors)} error/warning item(s) were logged. See errors/errors.txt")
    else:
        ctx.summary.append("WARNINGS: none recorded")

    ctx.summary.append("NEXT BEST FILE TO READ: manifests/manifest.json, then analysis_summary.txt, then the extracted/contact-sheet artifact matching the file type.")
    write_text(ctx, ctx.out_dir / "analysis_summary.txt", "\n".join(ctx.summary) + "\n")
    log_line(ctx, "INFO", "UNIVERSAL INTAKE END", {"created_files": len(ctx.created_files), "errors": len(ctx.errors)})


def detect_text_encoding(path: Path) -> tuple[str, str]:
    data = path.read_bytes()
    candidates = ["utf-8-sig", "utf-8", "cp1255", "windows-1252", "latin-1"]
    for enc in candidates:
        try:
            data.decode(enc)
            return enc, "decoded_without_error"
        except UnicodeDecodeError:
            continue
    return "utf-8", "fallback_replace"


def read_text_flexible(path: Path, forced_encoding: Optional[str] = None) -> tuple[str, str, str]:
    if forced_encoding:
        return path.read_text(encoding=forced_encoding, errors="replace"), forced_encoding, "forced"
    enc, reason = detect_text_encoding(path)
    return path.read_text(encoding=enc, errors="replace"), enc, reason


def normalize_newlines(text: str) -> str:
    return text.replace("\r\n", "\n").replace("\r", "\n")


def line_numbered_text(text: str) -> str:
    return "\n".join(f"{idx:06d}: {line}" for idx, line in enumerate(text.splitlines(), 1)) + "\n"


def write_chunks(ctx: IntakeContext, text: str, chunk_dir: Path, lines_per_chunk: int = 500) -> list[str]:
    ensure_dir(chunk_dir)
    lines = text.splitlines()
    paths = []
    for start in range(0, len(lines), lines_per_chunk):
        idx = start // lines_per_chunk + 1
        chunk_text = "\n".join(lines[start:start + lines_per_chunk]) + "\n"
        out = chunk_dir / f"chunk_{idx:04d}_lines_{start+1:06d}_{min(start+lines_per_chunk, len(lines)):06d}.txt"
        write_text(ctx, out, chunk_text)
        paths.append(str(out))
    return paths


def keyword_hits_rows(text: str, keywords: list[str]) -> list[dict[str, Any]]:
    rows = []
    lowered_keywords = [k.lower() for k in keywords]
    for line_no, line in enumerate(text.splitlines(), 1):
        low = line.lower()
        found = [k for k in lowered_keywords if k and k in low]
        if found:
            rows.append({"line": line_no, "keywords": ";".join(found), "text": line[:2000]})
    return rows


def write_csv_rows(ctx: IntakeContext, path: Path, rows: list[dict[str, Any]], fieldnames: Optional[list[str]] = None) -> None:
    ensure_dir(path.parent)
    if not fieldnames:
        fieldnames = sorted({key for row in rows for key in row.keys()}) if rows else ["message"]
    with path.open("w", encoding="utf-8-sig", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        for row in rows:
            writer.writerow(row)
    ctx.add_file(path)


def extract_timestamps_from_text(text: str) -> list[dict[str, Any]]:
    rows = []
    for line_no, line in enumerate(text.splitlines(), 1):
        for pattern in TIMESTAMP_PATTERNS:
            for m in pattern.finditer(line):
                rows.append({"line": line_no, "timestamp_text": m.group(0), "context": line[:1000]})
    return rows


def handle_text_like_file(ctx: IntakeContext, encoding: Optional[str] = None) -> None:
    text, enc, reason = read_text_flexible(ctx.input_path, encoding)
    text = normalize_newlines(text)
    base = safe_filename(ctx.input_path.stem)

    write_text(ctx, ctx.paths.extracted_text / f"{base}_utf8_normalized.txt", text)
    write_text(ctx, ctx.paths.extracted_text / f"{base}_numbered_lines.txt", line_numbered_text(text))
    chunk_paths = write_chunks(ctx, text, ctx.paths.extracted_text / "chunks")

    hits = keyword_hits_rows(text, ctx.keywords)
    write_csv_rows(ctx, ctx.paths.extracted_text / "keyword_hits.csv", hits, ["line", "keywords", "text"])

    ts_rows = extract_timestamps_from_text(text)
    write_csv_rows(ctx, ctx.paths.extracted_text / "timestamps.csv", ts_rows, ["line", "timestamp_text", "context"])

    stats = {
        "encoding": enc,
        "encoding_reason": reason,
        "line_count": len(text.splitlines()),
        "char_count": len(text),
        "keyword_hit_count": len(hits),
        "timestamp_hit_count": len(ts_rows),
        "chunk_count": len(chunk_paths),
    }
    write_json(ctx, ctx.paths.extracted_text / "line_stats.json", stats)
    ctx.manifest["text_like"] = stats
    ctx.summary.append(f"WHAT WAS EXTRACTED: text normalized to UTF-8, numbered lines, chunks, keyword hits, timestamp hits. Encoding={enc} ({reason}).")

    if ctx.input_path.suffix.lower() in {".csv", ".tsv"}:
        safe_call(ctx, "CSV_OVERVIEW", build_csv_overview, ctx, text)


def build_csv_overview(ctx: IntakeContext, text: str) -> None:
    sample = text[:8192]
    try:
        dialect = csv.Sniffer().sniff(sample)
        delimiter = dialect.delimiter
    except Exception:
        delimiter = "\t" if ctx.input_path.suffix.lower() == ".tsv" else ","
    rows = list(csv.reader(text.splitlines(), delimiter=delimiter))
    col_count = max((len(r) for r in rows), default=0)
    overview = {
        "delimiter": delimiter,
        "row_count": len(rows),
        "max_column_count": col_count,
        "first_rows": rows[:10],
    }
    write_json(ctx, ctx.paths.tables / "csv_overview.json", overview)
    ctx.manifest["csv_overview"] = overview

